# e2e 用の環境変数。.env.e2e.local にコピーして、値を入れる（*.local は Git 管理外）。
# DATABASE_URL は、Neon の e2e ブランチ（dev から作る）の直接接続。本番・dev の接続は入れない。
DATABASE_URL=
# ローカルのアプリの URL（playwright.config.ts のポートと同じ）。
BETTER_AUTH_URL=http://localhost:3100
# e2e 専用のランダムな文字列（本番の値を使い回さない）。
BETTER_AUTH_SECRET=
# e2e 専用の確認用アカウント。管理者のメールにしない。
DEMO_LOGIN_EMAIL=e2e-user@recipion.test
DEMO_LOGIN_CODE=123456
