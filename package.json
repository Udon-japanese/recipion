{
  "name": "recipion",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build && node scripts/postbuild-app-shell.ts",
    "preview": "vite preview",
    "waf:allowlist": "node scripts/print-waf-allowlist.ts",
    "lighthouse": "node scripts/lighthouse.ts",
    "deploy": "pnpm run build && wrangler deploy",
    "maintenance:on": "node scripts/maintenance-on.ts",
    "maintenance:off": "pnpm run deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "check:fix": "biome check --fix",
    "typecheck": "tsc --noEmit",
    "gate": "pnpm run check:fix && pnpm run typecheck && pnpm run test && pnpm run build",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest --project unit",
    "test:browser:watch": "vitest --project browser",
    "eval:lexicon": "RUN_MODERATION_EVAL=1 MODERATION_EVAL_LEXICON_ONLY=1 vitest run --project unit src/features/moderation/eval",
    "eval:ai": "RUN_MODERATION_EVAL=1 MODERATION_EVAL_LIMIT=${MODERATION_EVAL_LIMIT:-700} node --env-file=moderation-eval/eval.env.local node_modules/vitest/vitest.mjs run --project unit src/features/moderation/eval",
    "eval:ai:full": "RUN_MODERATION_EVAL=1 node --env-file=moderation-eval/eval.env.local node_modules/vitest/vitest.mjs run --project unit src/features/moderation/eval"
  },
  "dependencies": {
    "@dnd-kit/react": "^0.5.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "@vanilla-extract/css": "^1.21.3",
    "@vanilla-extract/recipes": "^0.5.7",
    "better-auth": "^1.7.12",
    "clsx": "^2.1.1",
    "destyle.css": "^4.0.1",
    "dexie": "^4.4.7",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "jose": "6.2.13",
    "nanoid": "^6.0.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@cloudflare/vite-plugin": "^1.65.0",
    "@tanstack/router-cli": "^1.167.46",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "chrome-launcher": "^1.2.2",
    "dotenv": "^18.0.9",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "lighthouse": "13.5.0",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0",
    "wrangler": "^4.152.0"
  }
}