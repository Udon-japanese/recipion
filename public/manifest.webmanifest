{
	"_comment": "name / short_name は src/config/app.ts の APP_DISPLAY_NAME と合わせること。theme_color は、ページの meta theme-color と、styles.css の --color-background と、同じ色にする（インストールした PWA の Android のナビゲーションバーは、manifest の theme_color で塗られる。書かないと黒になる。2026-11-11 に消したら黒になったため戻した）",
	"name": "れしぴょん",
	"short_name": "れしぴょん",
	"description": "レシピ、買い物メモ、在庫を管理するアプリ",
	"lang": "ja",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"background_color": "#fffdf7",
	"theme_color": "#fffdf7",
	"icons": [
		{
			"src": "/recipion-icon.svg",
			"sizes": "any",
			"type": "image/svg+xml",
			"purpose": "any maskable"
		}
	]
}