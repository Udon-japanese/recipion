{
	"_comment": "name / short_name は src/config/app.ts の APP_DISPLAY_NAME と合わせること。theme_color は書かない（Android の Chrome は、明るい theme_color でナビゲーションバーを塗ると、ページとの間に灰色の区切り線を引く。書かなければ、background_color の背景がそのまま見える。ステータスバーの色は、ページの meta theme-color で付く）",
	"name": "れしぴょん",
	"short_name": "れしぴょん",
	"description": "レシピ、買い物メモ、在庫を管理するアプリ",
	"lang": "ja",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"background_color": "#fffdf7",
	"icons": [
		{
			"src": "/recipion-icon.svg",
			"sizes": "any",
			"type": "image/svg+xml",
			"purpose": "any maskable"
		}
	]
}