{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "recipion",
	// 本番の URL は、カスタムドメイン https://recipion.app（Cloudflare Registrar で取得、同じアカウントのゾーン）。
	// `wrangler deploy` が、DNS レコードと証明書を自動で作る。
	"routes": [{ "pattern": "recipion.app", "custom_domain": true }],
	// 旧 URL（https://recipion.uj-yos.workers.dev）は使わない（引き継ぐデータも、アクセスした人もいない）。
	// workers.dev のホスト名は、公開された証明書の記録などから見つけられて bot に狙われやすく、
	// ゾーン（recipion.app）の WAF やレート制限の保護も受けられない。
	"workers_dev": false,
	// バージョンごとのプレビュー URL は使わない。同じ本番の DB とシークレットに接続でき、
	// BETTER_AUTH_URL が本番の URL に固定されているため、認証も正しく動かない。
	"preview_urls": false,
	// Workers Logs。bot のアクセスの量や、エラーを確認できるようにする。
	"observability": { "enabled": true },
	// ログイン用コードの送信と検証のレート制限（auth-rate-limit.ts）。period は 10 か 60 秒のみ。
	// 場所ごとに数える、結果整合の制限なので、正規のユーザーが不便にならない範囲に、やや緩めに設定している。
	"ratelimits": [
		// 同じメールアドレス宛ての送信（メール爆撃の防止）。再送の待ち時間は 60 秒なので、打ち間違いの分だけ余裕を持たせる。
		{
			"name": "AUTH_SEND_EMAIL_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 3, "period": 60 }
		},
		// 同じ IP からの送信（宛先を変えた連続送信の防止）。同じネットワークの複数人が使う場合を考えた余裕。
		{
			"name": "AUTH_SEND_IP_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 6, "period": 60 }
		},
		// 同じ IP からのコードの検証（総当たりの防止）。コード自体にも、試行回数の上限がある。
		{
			"name": "AUTH_VERIFY_IP_LIMITER",
			"namespace_id": "1003",
			"simple": { "limit": 15, "period": 60 }
		},
		// 他の人のレシピへのリンクのための、ユーザー・レシピの検索（1人あたり）。入力のたびに検索するので、やや多めに許す。
		{
			"name": "LINK_SEARCH_LIMITER",
			"namespace_id": "1004",
			"simple": { "limit": 40, "period": 60 }
		}
	],
	"compatibility_date": "2025-09-02",
	"compatibility_flags": ["nodejs_compat"],
	"main": "@tanstack/react-start/server-entry",
	// 公開しようとする文章の審査に使う Workers AI（features/moderation）。無料枠は 1 日 10,000 Neurons。
	"ai": { "binding": "AI" },
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "b947684c641f45198bae4469854c2741"
		}
	]
}